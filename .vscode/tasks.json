{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "R: Document",
            "type": "shell",
            "command": "Rscript -e 'devtools::document()'",
            "problemMatcher": []
        },
        {
            "label": "R: Install",
            "type": "shell",
            "command": "Rscript -e 'devtools::document(); devtools::install(upgrade = FALSE)'",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "R: Test",
            "type": "shell",
            "command": "Rscript -e 'devtools::test()'",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "R: Check",
            "type": "shell",
            "command": "Rscript -e 'devtools::check()'",
            "problemMatcher": []
        },
        {
            "label": "Site: Build",
            "type": "shell",
            "command": "Rscript -e 'devtools::install(upgrade = FALSE); pkgdown::build_site(preview = FALSE)'",
            "problemMatcher": []
        },
        {
            "label": "Site: Preview",
            "type": "shell",
            "command": "xdg-open docs/index.html",
            "problemMatcher": []
        }
    ]
}
